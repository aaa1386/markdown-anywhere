{
  "name": "markown-anywhere-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian settings plugin for Markown Anywhere.",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --external:obsidian --platform=node --format=cjs --target=es2018 --outfile=main.js --log-level=warning",
    "dev": "esbuild src/main.ts --bundle --external:obsidian --platform=node --format=cjs --target=es2018 --outfile=main.js --watch"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  }
}
